# Copy this file to .env (never commit .env). Pick ONE provider.

# Which backend to use: groq | ollama | openai | gemini
DATATIDY_PROVIDER=groq

# Optional: override the provider's default model (names change often)
# DATATIDY_MODEL=

# Groq (free tier, rate limited): https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini (free tier, rate limited): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI (paid, prepaid credits)
OPENAI_API_KEY=

# Ollama needs no key; just run:  ollama pull llama3.2
